  title       = {OrcaLoca: An LLM Agent Framework for Software Issue Localization},
  author      = {Yu, Zhongming and Zhang, Hejia and Zhao, Yujie and Huang, Hanxian and Yao, Matrix and Ding, Ke and Zhao, Jishen},
